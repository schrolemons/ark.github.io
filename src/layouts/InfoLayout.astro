---
import type {SubNavigationItem} from "../_types/SubNavigationItem"
import RootLayout from "./RootLayout.astro"
import LineDecorator from "../components/LineDecorator"
import PageTracker from "../components/PageTracker"

interface Props {
    title?: string
    subTitle?: string
    tabTitle?: string
    subNavigationItems?: SubNavigationItem[]
}

const title = Astro.props.title ?? "INFO"
const subTitle = Astro.props.subTitle ?? "情报中心"
const tabTitle = Astro.props.tabTitle ?? "情报中心"
const subNavigationItems = Astro.props.subNavigationItems
---

<RootLayout title={tabTitle} {...{subNavigationItems}}>
    <!-- TODO: Canvas 动态背景 -->
    <div class="landscape:hidden">
        <PageTracker client:only="react"/>
    </div>
    <LineDecorator client:only="react"/>
    <div class="w-full h-full flex pt-[9.5rem] portrait:pt-[9.375rem] portrait:pr-[5.75rem] break-words hyphens-auto text-ellipsis">
        {
            // TODO: 左侧栏竖屏适配

            Astro.slots.has("left-aside") &&
                <aside id="info-layout-left-aside-slot"
                       class="shrink-0 overflow-y-auto hidden sm:block">
                    <slot name="left-aside"/>
                </aside>
        }

        <main class="pb-[4.5rem] portrait:pt-[2.5rem] pl-8 portrait:pl-[1.875rem] portrait:pb-[12rem] box-border grow overflow-y-auto">
            <div id="info-layout-main-slot"
                 class="w-full h-full overflow-x-hidden overflow-y-auto"
                 style={{
                     // TODO: 上边框也添加渐变
                     mask: "linear-gradient(0deg, transparent, #000 1rem)"
                 }}>
                <slot/>
            </div>
        </main>

        <aside class="w-[25.5rem] flex flex-col items-end justify-between portrait:hidden">
            <header id="info-layout-right-aside-header-slot"
                    class="w-full h-full overflow-y-auto grow portrait:hidden">
                <slot name="aside-header"/>
            </header>

            <div class="text-right select-none">
                <div class="text-[1.25rem] text-ark-blue font-black pr-9">
                    {subTitle}
                </div>
                <div class="text-[#5f5f5f] text-[12.5rem] leading-none font-oswaldMedium tracking-[-.625rem] pr-8">
                    <!-- TODO: 竖屏模式也半透明显示在左下角 -->
                    {title}
                </div>
            </div>

            <footer id="info-layout-right-aside-footer-slot"
                    class="w-full mt-8 mb-[13.25rem] pr-[2.625rem] box-border flex flex-col items-end">
                <slot name="aside-footer"/>
            </footer>
        </aside>
    </div>

    {
        Astro.slots.has("tool-panel") &&
            <div id="info-layout-tool-panel-slot"
                 class="h-[3.75rem] mb-[9.5rem] portrait:mb-[5.75rem] absolute bottom-0 right-0 flex z-10">
                <slot name="tool-panel"/>
            </div>
    }
</RootLayout>

<script>
    import {viewIndex} from "../components/store/rootLayoutStore"
    import {directions} from "../components/store/lineDecoratorStore"

    viewIndex.set(1)

    function handleWindowsResize() {
        if (window.innerWidth > window.innerHeight)
            directions.set({top: true, right: false, bottom: false, left: false})
        else
            directions.set({top: true, right: true, bottom: false, left: false})
    }

    handleWindowsResize()
    window.addEventListener("resize", handleWindowsResize)
</script>

<style lang="scss" is:global>
  // 文章排版样式 — 情报终端阅读体验
  article {
    max-width: 48rem;
    font-size: 1.125rem;
    line-height: 2;
    font-family: "Source Han Sans", "微软雅黑", sans-serif;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.025em;

    // ========== 选中 ==========
    ::selection {
      color: #000;
      background-color: #ffd700;
    }

    // ========== 段落 ==========
    p {
      margin: 1.25rem 0;
      text-align: justify;
      text-indent: 2em;

      img {
        display: inline-block;
      }
    }

    // ========== 标题体系 ==========
    h1, h2, h3, h4, h5, h6 {
      color: #fff;
      line-height: 1.3;
      letter-spacing: 0.05em;
    }

    h1 {
      font-size: 2.5rem;
      font-weight: 900;
      margin: 3rem 0 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 2px solid #ffd700;
      text-indent: 0;
    }

    h2 {
      font-size: 1.75rem;
      font-weight: 800;
      margin: 2.5rem 0 1.25rem;
      padding-left: 1.25rem;
      border-left: 4px solid #ffd700;
      text-indent: 0;
    }

    h3 {
      font-size: 1.5rem;
      font-weight: 700;
      margin: 2rem 0 1rem;
      padding-left: 0.75rem;
      border-left: 3px solid rgba(255, 215, 0, 0.6);
      text-indent: 0;
    }

    h4 {
      font-size: 1.3rem;
      font-weight: 700;
      margin: 1.75rem 0 0.75rem;
      text-indent: 0;
    }

    h5 {
      font-size: 1.2rem;
      font-weight: 600;
      margin: 1.5rem 0 0.5rem;
      text-indent: 0;
    }

    h6 {
      font-size: 1.1rem;
      font-weight: 500;
      margin: 1.25rem 0 0.5rem;
      text-indent: 0;
    }

    // ========== 分割线 ==========
    hr {
      margin: 2.5rem 0;
      border: none;
      height: 1px;
      background: linear-gradient(90deg, transparent, #ffd700, transparent);
      opacity: 0.6;
    }

    // ========== 强调 ==========
    strong {
      color: #ffd700;
      font-weight: 800;
    }

    em {
      color: rgba(255, 255, 255, 0.9);
      font-style: italic;
    }

    em strong {
      color: #ffe44d;
      font-weight: 900;
    }

    // ========== 删除线 ==========
    del {
      color: rgba(255, 255, 255, 0.35);
      text-decoration: line-through;
    }

    // ========== 链接 ==========
    a {
      color: #ffd700;
      padding: 0 2px;
      text-decoration: none;
      border-bottom: 1px solid rgba(255, 215, 0, 0.4);
      transition: color 200ms, background-color 200ms, border-color 200ms;

      &:hover {
        color: #000;
        background-color: #ffd700;
        border-bottom-color: #ffd700;
      }
    }

    // ========== 引用块 ==========
    blockquote {
      margin: 1.5rem 0;
      padding: 1rem 1.5rem;
      border-left: 4px solid #ffd700;
      background: rgba(255, 215, 0, 0.06);
      border-radius: 0 4px 4px 0;

      p {
        margin: 0.5rem 0;
        text-indent: 0;
      }

      blockquote {
        margin: 0.75rem 0;
        border-left-color: rgba(255, 215, 0, 0.4);
        background: rgba(255, 215, 0, 0.03);
      }
    }

    // ========== 列表 ==========
    ul, ol {
      margin: 1.25rem 0;
      padding-left: 2rem;
      line-height: 1.9;

      li {
        margin: 0.35rem 0;
      }

      ul, ol {
        margin: 0.25rem 0;
      }
    }

    ul {
      list-style: none;

      li {
        position: relative;
        padding-left: 0.25rem;

        &::before {
          content: "▸";
          position: absolute;
          left: -1.5rem;
          color: #ffd700;
          font-size: 0.75rem;
          top: 0.15rem;
        }
      }
    }

    ol {
      list-style: none;
      counter-reset: article-ol;

      li {
        counter-increment: article-ol;

        &::before {
          content: counter(article-ol, decimal-leading-zero) ".";
          color: #ffd700;
          font-weight: 700;
          font-family: "Oswald-Medium", monospace;
          margin-right: 0.5rem;
        }
      }
    }

    // ========== 内联代码 ==========
    p, li, th, td {
      code {
        background-color: rgba(255, 255, 255, 0.1);
        color: #ffd700;
        padding: 0.15em 0.4em;
        border-radius: 3px;
        font-size: 0.9em;
        font-family: "SF Mono", "Fira Code", "Cascadia Code", monospace;
      }
    }

    // ========== 代码块 ==========
    .astro-code {
      margin: 1.5rem 0;
      padding: 1.25rem 1.5rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 6px;
      background: rgba(0, 0, 0, 0.4) !important;
      font-size: 0.9rem;
      line-height: 1.6;
      overflow-x: auto;
    }

    // ========== 表格 ==========
    table {
      width: 100%;
      margin: 1.5rem 0;
      border-collapse: collapse;
      font-size: 0.95rem;
    }

    th, td {
      padding: 0.6rem 1rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      text-align: left;
    }

    th {
      background: rgba(255, 215, 0, 0.1);
      color: #ffd700;
      font-weight: 700;
      font-family: "Oswald-Medium", sans-serif;
      letter-spacing: 0.08em;
    }

    tr:hover td {
      background: rgba(255, 255, 255, 0.03);
    }

    // ========== 图片 ==========
    img {
      max-width: 100%;
      height: auto;
      border-radius: 4px;
    }

    // ========== 脚注 ==========
    .footnotes {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.5);
    }
  }

  // ========== Note 块 ==========
  .note-block {
    margin: 1.5rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid;
    border-left-width: 4px;
    border-radius: 0 6px 6px 0;
    font-size: 1rem;
    line-height: 1.8;

    p {
      margin: 0.5rem 0;
      text-indent: 0;
    }

    p:first-child { margin-top: 0; }
    p:last-child { margin-bottom: 0; }

    // Info: 蓝调 — 资讯/说明
    &.note-block--info {
      border-color: rgba(74, 144, 217, 0.5);
      background: rgba(74, 144, 217, 0.12);
      color: rgba(255, 255, 255, 0.9);

      strong { color: #5ba0f0; }
      a { color: #5ba0f0; border-bottom-color: rgba(91, 160, 240, 0.4);
        &:hover { color: #000; background-color: #5ba0f0; }
      }
    }

    // Primary: 金调 — 重点/强调
    &.note-block--primary {
      border-color: rgba(255, 215, 0, 0.5);
      background: rgba(255, 215, 0, 0.12);
      color: rgba(255, 255, 255, 0.95);

      strong { color: #ffe44d; }
      a { color: #ffd700; border-bottom-color: rgba(255, 215, 0, 0.4);
        &:hover { color: #000; background-color: #ffd700; }
      }
    }

    // Danger: 红调 — 危险/警告
    &.note-block--danger {
      border-color: rgba(231, 76, 60, 0.5);
      background: rgba(231, 76, 60, 0.12);
      color: rgba(255, 255, 255, 0.9);

      strong { color: #f07070; }
      a { color: #f07070; border-bottom-color: rgba(240, 112, 112, 0.4);
        &:hover { color: #000; background-color: #f07070; }
      }
    }

    // Warning: 橙调 — 提醒/注意
    &.note-block--warning {
      border-color: rgba(243, 156, 18, 0.5);
      background: rgba(243, 156, 18, 0.12);
      color: rgba(255, 255, 255, 0.9);

      strong { color: #f5b840; }
      a { color: #f5b840; border-bottom-color: rgba(245, 184, 64, 0.4);
        &:hover { color: #000; background-color: #f5b840; }
      }
    }
  }
</style>
