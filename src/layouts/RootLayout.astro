---
import type {SubNavigationItem} from "../_types/SubNavigationItem";
import "../_styles/base.css"
import FontFace from "../_styles/FontFace.astro"
import Scrollbar from "../_styles/Scrollbar.astro"
import ResponsiveFontSize from "../components/ResponsiveFontSize.astro"
import Header from "../components/header/Header.astro"
import {Menu} from "../components/header/NavMenu"
import OwnerInfo from "../components/OwnerInfo"
import {SvgDefs} from "../components/SvgIcons"
import IdentityDialog from "../components/Identity"
import "../_styles/responsive.css"
import "../_styles/mobile-refresh.css"

interface Props {
    lang?: string
    title?: string
    description?: string
    subNavigationItems?: SubNavigationItem[]
}

const base = import.meta.env.BASE_URL
const {lang, title, description, subNavigationItems} = Astro.props
---

<!DOCTYPE html>
<html lang={lang} class="h-full bg-black" style="font-size: 16px" data-identity-pending="true">
<head>
    <meta charset="UTF-8"/>
    <meta name="description" content={description}/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"}/>
    <meta name="generator" content={Astro.generator}/>
    <base target="_blank"/>
    <title>{title}</title>
    <FontFace/>
    <Scrollbar/>
    <ResponsiveFontSize/>
</head>
<body class="w-full h-full text-white bg-black m-0 overflow-hidden">
  <div id="site-shell" class="w-full h-full relative bg-layout bg-center bg-cover bg-no-repeat">
    <div class="relative w-full h-full m-auto max-w-[180rem]">
        <Header/>
        <slot/>
        <Menu client:only="react" {...{subNavigationItems}}/>
        <OwnerInfo client:only="react"/>
    </div>
  </div>
  <IdentityDialog client:only="react"/>
  <noscript><style>html[data-identity-pending="true"] body::before { display: none; }</style><p>请启用 JavaScript 以使用互动页面及身份入口。</p></noscript>
  <SvgDefs/>
</body>
</html>

<script>
  import {rememberNavigation} from '../utils/navigation';
  rememberNavigation();
</script>
