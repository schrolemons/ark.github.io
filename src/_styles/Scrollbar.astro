<style is:global>
    /* For Webkit browsers (Chrome, Safari, Edge) */
    ::-webkit-scrollbar {
        /* width: 6px;
           height: 6px; */
    }

    ::-webkit-scrollbar-track {
        background: #5a5a5a;
    }

    ::-webkit-scrollbar-thumb {
        background: #ffd700;
        border-radius: 0; /* Ensure no rounded corners */
        box-shadow: inset 0 0 0 0 #000; /* Remove any shadow that might create a rounded effect */
    }

    ::-webkit-scrollbar-thumb:horizontal {
        border-radius: 0; /* Ensure no rounded corners for horizontal scrollbar */
    }

    ::-webkit-scrollbar-thumb:vertical {
        border-radius: 0; /* Ensure no rounded corners for vertical scrollbar */
    }

    ::-webkit-scrollbar-button {
        display: none;
    }

    /* For Firefox */
    * {
        scrollbar-width: thin;
        scrollbar-color: #ffd700 #5a5a5a;
    }

    /* For Internet Explorer and Edge (Legacy) */
    body {
        -ms-overflow-style: none; /* IE and Edge */
    }

    body::-ms-scrollbar {
        /* width: 6px;
           height: 6px; */
    }

    body::-ms-scrollbar-track {
        background: #5a5a5a;
    }

    body::-ms-scrollbar-thumb {
        background: #ffd700;
        border-radius: 0; /* Ensure no rounded corners */
    }

    body::-ms-scrollbar-button {
        display: none;
    }

    /* Mobile keeps scrolling gesture-only. The desktop gold scrollbar is too
       visually dominant beside the compact right-side section rail. */
    @media (max-width: 1024px), (orientation: portrait) {
        * {
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        *::-webkit-scrollbar {
            width: 0;
            height: 0;
            display: none;
        }
    }
</style>
