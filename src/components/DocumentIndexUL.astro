---
import type {MarkdownHeading} from "astro";

interface Props {
    headings: MarkdownHeading[]
}

const headings = Astro.props.headings

// TODO: 添加类似 header/NavMenu 的动效
// TODO: 跟随正文滚动、当前阅读段落标题高亮
---

<ul class="h-full text-[15px] mt-[.8rem] overflow-x-hidden overflow-y-auto space-y-0.5">
    {headings.map((item) =>
            <li class="group transition-colors duration-200" style={{paddingLeft: 1.2 * item.depth + "rem"}}>
                <a target="_self" href={"#" + item.slug}
                   class="block py-1.5 text-white/50 no-underline hover:text-ark-blue transition-colors duration-200 border-l-2 border-transparent hover:border-ark-blue"
                   style={{paddingLeft: (0.4 + 0.3 * item.depth) + "rem"}}>
                    {item.text}
                </a>
            </li>)}
</ul>
