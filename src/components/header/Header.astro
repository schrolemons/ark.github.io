---
import type {NavbarItem} from "../../_types/ArknightsConfig";
import arknightsConfig from "../../../arknights.config";
import NavItem from "./NavItem"
import {Share, Sound, OwnerInfo} from "./NavTools"
import NavMenu from "./NavMenu"
import {IdentityBrand} from "../Identity"

---

<header class="site-header w-full h-[6.75rem] portrait:h-[9.375rem] absolute top-0 left-0 z-[23] flex items-center"
        style="background-image: linear-gradient(0deg, transparent, rgba(0, 0, 0, .6), rgba(0, 0, 0, .8))">
    <a target="_self" href={"/"} class="site-brand mr-auto ml-12 cursor-pointer" aria-label="首页">
        <IdentityBrand client:only="react"/>
    </a>
    <nav class="portrait:hidden">
        <ul class="flex justify-evenly">{
            arknightsConfig.navbar.items.map((info: NavbarItem, index) =>
                    <NavItem client:only="react" {...{index, info}}/>)
        }</ul>
    </nav>
    <div class="header-tools w-[14.75rem] h-full flex pl-[.75rem]">
        <Share client:only="react"/>
        <Sound client:only="react"/>
        <OwnerInfo client:only="react"/>
    </div>
    <NavMenu client:only="react"/>
</header>
