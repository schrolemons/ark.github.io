---
import {getCollection} from "astro:content";
// import {Debug} from 'astro:components'
import InfoLayout from "../../layouts/InfoLayout.astro";
import GoBackTool from "../../components/GoBackTool";


export async function getStaticPaths() {
    const allworld = await getCollection("world")

    return allworld.map(entry => ({
        params: {slug: entry.slug},
        props: {entry}
    }))
}

const {entry} = Astro.props;
const {Content, headings} = await entry.render();
const goBackHref = import.meta.env.BASE_URL + "world"
const tabTitle = entry?.data?.title ?? "无标题"
---
<InfoLayout title="ARCHIVE" subTitle="文章档案" {...{tabTitle, headings}} articleTitle={tabTitle} overviewHref={goBackHref}>
    <div id="reader-body" class="reader-body max-w-[80.75rem] mx-auto">
        <header class="reader-article-heading"><small>SCHNIE / ARCHIVE</small><h1>{tabTitle}</h1></header>
        <article><Content/></article>
    </div>
    <GoBackTool slot="tool-panel" client:load {...{goBackHref}}/>
</InfoLayout>
